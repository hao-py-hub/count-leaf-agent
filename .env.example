# Doubao Ark Vision API
ARK_API_KEY=your_api_key_here
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VLM_MODEL=ep-20260420011113-6jvmx
ANALYSIS_ALGORITHM_VERSION=stalk-v0.1
ANALYSIS_PROMPT_VERSION=phenotype-prompt-v1
# Optional estimated billing rates in your accounting currency per one million tokens.
# Keep both at 0 when the provider price is unknown; the ledger will preserve NULL cost.
VLM_INPUT_COST_PER_MILLION=0
VLM_OUTPUT_COST_PER_MILLION=0
# Optional per-crop foreign-plant detection. Disabled by default because it adds VLM calls.
ENABLE_VLM_ADHESION_DETECTION=false
VLM_FP_CONFIDENCE_THRESHOLD=0.8
# Stalk Pass 1 dead-twig fences, as fractions of per-image median width/area.
# Both must be in (0, 1]; lower values retain more thin/small branches.
STALK_TWIG_WIDTH_RATIO=0.70
STALK_TWIG_AREA_RATIO=0.25

# VLM 请求选项
# 思考模式。disabled（默认）关掉思考，单次调用从数百秒降到十几秒；
# 设为 default 则沿用模型自带配置（思考开启）。
VLM_THINKING=disabled
# 单次请求超时（秒）与失败重试次数
VLM_TIMEOUT_S=120
VLM_MAX_RETRIES=1

# Server
HOST=0.0.0.0
PORT=8501

# Enterprise infrastructure (optional; use with Docker Compose enterprise profile)
DATABASE_URL=postgresql+psycopg://phenotype:phenotype@postgres:5432/phenotype_agent
REDIS_URL=redis://redis:6379/0
CELERY_TASK_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
JOB_EXECUTOR_MODE=in_process
DAILY_ANALYSIS_JOB_LIMIT=100
ANALYSIS_JOB_TIMEOUT_SECONDS=300

# Comma-separated browser origins allowed to call the API. Do not use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
MAX_IMAGE_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=40000000
MAX_KNOWLEDGE_UPLOAD_BYTES=524288

# Local RAG retrieval. "keyword" is the stable default; "hybrid" also expands
# a small, domain-specific synonym set without requiring embeddings or Docker.
RAG_RETRIEVAL_MODE=keyword
# Enterprise Agent v0.1: development persistence
DATABASE_URL=sqlite:///./data/agent.sqlite3
# Relative SQLite paths are resolved against this project directory.
JOB_EXECUTOR_MODE=in_process

# Language model used by the future Agent conversation and report workflow.
# DeepSeek provides an OpenAI-compatible endpoint. Do not put a real key here.
LLM_PROVIDER=deepseek
LLM_ENABLED=false
LLM_MODEL=deepseek-chat
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key

# Used only after switching JOB_EXECUTOR_MODE to celery in enterprise deployment.
REDIS_URL=redis://redis:6379/0
CELERY_TASK_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
